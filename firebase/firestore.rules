rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    function notBlocked(userId) {
      return !exists(/databases/$(database)/documents/users/$(userId)/blocks/$(request.auth.uid));
    }

    // A client may include isAdmin/premium in a write (the app always echoes them),
    // but the values must be truthful: isAdmin must have role == 'admin' in their own user doc,
    // and premium may only be set to a value the user already had (or true if admin).
    function safeFields() {
      let d = request.resource.data;
      let claimedAdmin = ('isAdmin' in d) && d.isAdmin == true;
      let claimedPremium = ('premium' in d) && d.premium == true;
      let existingPremium = resource != null && ('premium' in resource.data) && resource.data.premium == true;
      return (!claimedAdmin || isAdmin())
             && (!claimedPremium || isAdmin() || existingPremium);
    }

    // 'edad' (age) must be provided and must be an adult.
    function validAge() {
      let d = request.resource.data;
      return ('edad' in d) && d.edad is int && d.edad >= 18;
    }

    match /users/{userId} {
      // get() can safely check the blocks collection per-document; list queries cannot
      // (Firestore can't resolve a concatenated exists() path during query-safety analysis).
      allow get: if request.auth != null && notBlocked(userId);
      allow list: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId && safeFields() && validAge();
      allow update: if isAdmin() || (request.auth != null && request.auth.uid == userId && safeFields() && validAge());

      match /blocks/{blockedId} {
        allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      }
    }

    match /locations/{userId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    match /chats/{chatId} {
      allow read, update: if isAdmin() || (request.auth != null && request.auth.uid in resource.data.users);
      allow create: if isAdmin() || (request.auth != null && request.auth.uid in request.resource.data.users);

      match /messages/{messageId} {
        allow read: if isAdmin() || (request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users);
        allow write: if isAdmin() || (request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users);
      }
    }

    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read, write: if isAdmin();
    }

    match /subscriptions/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow write: if isAdmin();
    }

    match /likes/{likeId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.fromId || request.auth.uid == resource.data.toId);
      allow create, update: if request.auth != null && request.auth.uid == request.resource.data.fromId;
    }

    match /visits/{visitId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.visitedId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == request.resource.data.visitorId;
    }

    match /matches/{matchId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.users;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.users;
    }

    match /verifications/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
