rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'cesar.herrera.rojo@gmail.com';
    }

    // Reglas básicas para el MVP
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }
    
    match /locations/{userId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }
    
    match /chats/{chatId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid in resource.data.users);
      allow create: if isAdmin() || (request.auth != null && request.auth.uid in request.resource.data.users);
      
      match /messages/{messageId} {
        allow read, write: if isAdmin() || (request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users);
      }
    }
    
    match /subscriptions/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow write: if isAdmin();
    }

    match /likes/{likeId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.fromId || request.auth.uid == resource.data.toId);
      allow write: if request.auth != null && request.auth.uid == request.resource.data.fromId;
    }
    
    match /visits/{visitId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.visitedId || request.auth.uid == resource.data.visitorId);
      allow write: if request.auth != null && request.auth.uid == request.resource.data.visitorId;
    }
    
    match /matches/{matchId} {
      allow read, write: if request.auth != null && request.auth.uid in (resource == null ? request.resource.data.users : resource.data.users);
    }

    match /verifications/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
