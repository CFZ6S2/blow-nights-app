{
  "hosting": [
    {
      "site": "blownights-main",
      "target": "blownights-main",
      "public": "frontend/.next",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
    },
    {
      "site": "darknights",
      "target": "darknights",
      "public": "darknights/frontend/.next",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions"
  }
}
