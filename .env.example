# ============================================
# GAY MEET APP — Environment Variables Example
# ============================================
# Copy this file and rename it to frontend/.env.local
# Fill in all values before running the project.

# --- Firebase Client SDK (Frontend) ---
# Get these from: Firebase Console > Project Settings > General > Your Apps
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=1:your_sender_id:web:your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-YOUR_MEASUREMENT_ID

# --- Mapbox (Map rendering) ---
# Get this from: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# --- Stripe (Payments) ---
# Get these from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_live_your_stripe_public_key

# --- Admin ---
# Email address of the admin user
NEXT_PUBLIC_ADMIN_EMAIL=your_admin_email@example.com

# --- Firebase Admin / Cloud Functions ---
# Set via Firebase CLI: firebase functions:config:set stripe.secret_key="sk_live_..."
# Or use Google Secret Manager in production
# STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# ADMIN_EMAIL=your_admin_email@example.com
