rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Funciones de validación
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    
    function isSizeLessThan(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }
    
    // 7. Default deny: todo lo no especificado explícitamente queda denegado
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Perfiles
    match /profilePictures/{userId}/{fileName} {
      allow read: if isAuthenticated() && !fileName.matches('private-.*');
      allow read: if isAuthenticated() && request.auth.uid == userId;
      // 1 y 2. MIME type y Size limit 5MB
      allow write: if isAuthenticated() && request.auth.uid == userId
                   && isImage() && isSizeLessThan(5);
    }

    // Chats
    match /chatMedia/{chatId}/{allPaths=**} {
      allow read: if isAuthenticated() && request.auth.uid in chatId.split('_');
      allow write: if isAuthenticated()
        && isSizeLessThan(5)
        && (request.resource.contentType.matches('image/(jpeg|png|webp|gif)') || request.resource.contentType.matches('audio/(webm|ogg|mp4|aac|mpeg)'))
        && request.auth.uid in chatId.split('_');
    }

    // Verificaciones (KYC/Identidad)
    match /verifications/{allPaths=**} {
      allow write: if isAuthenticated() && isImage() && isSizeLessThan(5);
      allow read: if false; // Solo backend/admin
    }

    // Eventos de Venues
    match /venues/{venueId}/events/{eventId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated()
                   && isImage() && isSizeLessThan(10)
                   && firestore.get(/databases/(default)/documents/venues/$(venueId)).data.ownerId == request.auth.uid;
    }

    // Eventos Independientes / RRPP
    match /events/{eventId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated()
                   && isImage() && isSizeLessThan(10)
                   && firestore.get(/databases/(default)/documents/events/$(eventId)).data.organizerId == request.auth.uid;
    }

    // 5. Ticket protection (Protección explícita de entradas/QRs)
    match /tickets/{allPaths=**} {
      // Solo Cloud Functions pueden escribir tickets
      allow write: if false;
      allow read: if isAuthenticated();
    }
    
    // Backups o datos del sistema protegidos
    match /backups/{allPaths=**} {
      allow read, write: if false;
    }

    // 6. Temporal uploads (subidas que expirarán pronto si se implementa expiración)
    match /temp/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isImage() && isSizeLessThan(5);
    }
  }
}
