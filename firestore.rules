rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (request.auth.token.role == 'admin' || request.auth.token.role == 'superadmin');
    }

    function isCityAdmin(cityId) {
      return request.auth != null && request.auth.token.role == 'cityAdmin' && request.auth.token.cityId == cityId;
    }

    function notBanned() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) == false;
    }

    function notBlocked(userId) {
      return !exists(/databases/$(database)/documents/users/$(userId)/blocks/$(request.auth.uid));
    }

    function safeFields() {
      let existingData = resource == null ? {} : resource.data;
      return !request.resource.data.diff(existingData).affectedKeys()
        .hasAny(['role', 'isAdmin', 'is_admin', 'premium', 'verified', 'created_at', 'isVIPNight', 'dailyPingsLeft', 'invitesCount', 'verificationStatus']);
    }

    function validPingReset() {
      let existingData = resource.data;
      let newData = request.resource.data;
      let changedKeys = newData.diff(existingData).affectedKeys();
      
      // If dailyPingsLeft or lastPingReset are changing
      return (!changedKeys.hasAny(['dailyPingsLeft', 'lastPingReset'])) || (
        newData.dailyPingsLeft == 3 &&
        existingData.lastPingReset != null &&
        request.time.toMillis() >= existingData.lastPingReset.toMillis() + (4 * 60 * 60 * 1000)
      );
    }

    function hasChillAccess() {
      return request.auth.token.premium == true
        || (request.auth.token.pass_expires is number && request.auth.token.pass_expires > request.time.toMillis());
    }

    function validAge() {
      let d = request.resource.data;
      return !('edad' in d) || d.edad == null || (d.edad is int && d.edad >= 18);
    }

    match /users/{userId} {
      allow get: if request.auth != null && notBlocked(userId);
      allow list: if isAdmin() || (request.auth != null && request.query.limit <= 150);
      allow update: if (request.auth.uid == userId && notBanned() && safeFields() && validAge() && validPingReset()) || isAdmin();
      allow create, delete: if isAdmin();

      match /blocks/{blockedId} {
        allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      }
    }

    match /locations/{userId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    match /chats/{chatId} {
      allow read, update: if isAdmin() || (request.auth != null && request.auth.uid in resource.data.users);
      allow create: if isAdmin() || (request.auth != null && notBanned() && request.auth.uid in request.resource.data.users);

      match /messages/{messageId} {
        allow read: if isAdmin() || (request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users);
        allow write: if isAdmin() || (request.auth != null && notBanned() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users);
      }
    }

    match /reports/{reportId} {
      allow create: if request.auth != null && notBanned();
      allow read, write: if isAdmin();
    }

    match /subscriptions/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow write: if isAdmin();
    }

    match /likes/{likeId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.fromId || request.auth.uid == resource.data.toId);
      allow create, update: if request.auth != null && notBanned() && request.auth.uid == request.resource.data.fromId;
    }

    match /visits/{visitId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.visitedId || isAdmin());
      allow create: if request.auth != null && notBanned() && request.auth.uid == request.resource.data.visitorId;
    }

    match /matches/{matchId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.users;
      allow create: if false;
    }

    match /verifications/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.status == 'pending';
      allow update: if isAdmin();
    }

    // ── Multi-tenant: Cities ──

    match /cities/{cityId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /earnings/{earningId} {
        allow read: if isAdmin() || isCityAdmin(cityId);
      }
    }

    // ── Nightlife Hub collections ──

    match /venues/{venueId} {
      allow read: if true;
      allow create: if isAdmin()
        || isCityAdmin(request.resource.data.cityId)
        || (request.auth != null && (request.auth.uid == request.resource.data.ownerId || request.resource.data.ownerId == 'community'));
      allow update: if isAdmin()
        || isCityAdmin(resource.data.cityId)
        || (request.auth != null && (
             request.auth.uid == resource.data.ownerId
             || (resource.data.ownerId == 'community' && request.auth.uid == resource.data.createdBy)
           ));
      allow delete: if isAdmin()
        || isCityAdmin(resource.data.cityId)
        || (request.auth != null && (
             request.auth.uid == resource.data.ownerId 
             || (resource.data.ownerId == 'community' && request.auth.uid == resource.data.createdBy)
           ));

      match /events/{eventId} {
        allow read: if true;
        allow write: if isAdmin() || (request.auth != null && request.auth.uid == get(/databases/$(database)/documents/venues/$(venueId)).data.ownerId);
      }

      match /promoters/{promoterId} {
        allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == get(/databases/$(database)/documents/venues/$(venueId)).data.ownerId);
      }
    }

    match /checkins/{checkinId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && (request.auth.uid == request.resource.data.userId
            || request.auth.uid == request.resource.data.realUserId);
      allow update, delete: if isAdmin()
        || (request.auth != null && request.auth.uid == resource.data.userId)
        || (request.auth != null && request.auth.uid == resource.data.realUserId);
    }

    match /tickets/{ticketId} {
      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid == resource.data.userId)
        || (request.auth != null && resource.data.venueOwnerId == request.auth.uid);
      allow update: if isAdmin()
        || (request.auth != null && resource.data.venueOwnerId == request.auth.uid);
    }

    match /promotions/{promoId} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin()
        || isCityAdmin(request.resource.data.cityId)
        || (request.auth != null && request.auth.uid == request.resource.data.venueOwnerId);
      allow delete: if isAdmin()
        || isCityAdmin(resource.data.cityId)
        || (request.auth != null && request.auth.uid == resource.data.venueOwnerId);
    }

    // ── Chills / Afters privados ──

    // ── Guest Checkout: Entradas y QR dinámico (Público si tienes enlace) ──
    match /chill_requests/{requestId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && notBanned() && request.auth.uid == request.resource.data.user_uid;
      allow update, delete: if request.auth != null && notBanned() && request.auth.uid == resource.data.user_uid;
    }

    match /chills/{chillId} {
      allow get: if true; // Para mostrar info del evento al invitado
      allow list: if request.auth != null;
      allow create: if request.auth != null && notBanned()
        && request.auth.uid == request.resource.data.host_uid
        && hasChillAccess();
      allow update: if isAdmin()
        || (request.auth != null && request.auth.uid == resource.data.host_uid);
      allow delete: if isAdmin()
        || (request.auth != null && request.auth.uid == resource.data.host_uid);

      match /private/{docId} {
        allow read: if request.auth != null
          && (request.auth.uid == get(/databases/$(database)/documents/chills/$(chillId)).data.host_uid
              || request.auth.uid in get(/databases/$(database)/documents/chills/$(chillId)).data.accepted_users);
        allow write: if false;
      }

      match /requests/{requestId} {
        allow read: if request.auth != null
          && (request.auth.uid == resource.data.user_uid
              || request.auth.uid == get(/databases/$(database)/documents/chills/$(chillId)).data.host_uid);
        allow create: if request.auth != null
          && request.auth.uid == request.resource.data.user_uid
          && hasChillAccess();
        allow update: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/chills/$(chillId)).data.host_uid;
      }

      match /messages/{messageId} {
        allow read: if request.auth != null
          && (request.auth.uid in get(/databases/$(database)/documents/chills/$(chillId)).data.accepted_users
              || request.auth.uid == get(/databases/$(database)/documents/chills/$(chillId)).data.host_uid);
        allow create: if request.auth != null
          && (request.auth.uid in get(/databases/$(database)/documents/chills/$(chillId)).data.accepted_users
              || request.auth.uid == get(/databases/$(database)/documents/chills/$(chillId)).data.host_uid);
      }
    }

    // ── Modo Swipe & Vente Aquí ──
    match /pings/{pingId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId);
      allow create: if request.auth != null && notBanned() && request.auth.uid == request.resource.data.fromUserId
        && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.dailyPingsLeft > 0
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isVIPNight == true);
    }

    // ── Configuración Global (Feature Flags) ──
    match /settings/platform {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /partner_applications/{appId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.userId);
      allow update, delete: if isAdmin();
    }

    match /users/{userId}/earnings/{earningId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
