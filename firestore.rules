rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'cesar.herrera.rojo@gmail.com';
    }

    // Reglas básicas para el MVP
    match /users/{userId} {
      // Authenticated users can read any profile (not blocked)
      allow read: if request.auth != null && !exists(/databases/$(database)/documents/blocks/$(userId) + '_' + request.auth.uid);
      // Public can only read the 'online' and 'fotoUrl' fields for landing page stats
      allow read: if request.auth == null && resource.data.keys().hasOnly(['online', 'fotoUrl', 'nick']);
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }
    
    match /locations/{userId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }
    
    match /chats/{chatId} {
      allow read, update: if isAdmin() || (request.auth != null && request.auth.uid in resource.data.users);
      allow create: if isAdmin() || (request.auth != null && request.auth.uid in request.resource.data.users);
      
      match /messages/{messageId} {
        allow read: if isAdmin() || (request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users);
        allow write: if isAdmin() || (request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users);
      }
    }

    match /blocks/{blockId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.blockerId || request.auth.uid == resource.data.blockedId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.blockerId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.blockerId;
    }
    
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read, write: if isAdmin();
    }
    
    match /subscriptions/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow write: if isAdmin();
    }

    match /likes/{likeId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.fromId || request.auth.uid == resource.data.toId);
      allow create, update: if request.auth != null && request.auth.uid == request.resource.data.fromId;
    }
    
    match /visits/{visitId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.visitedId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == request.resource.data.visitorId;
    }
    
    match /matches/{matchId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.users;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.users;
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
