# Copia este archivo a functions/.env y rellena tus claves reales de Stripe
# para activar los pagos. Con .env vacío o ausente, la app funciona con
# normalidad pero el botón de "Hazte Premium" mostrará un error controlado
# en vez de romperse (ver getStripe() en functions/index.js).

# Dashboard de Stripe > Developers > API keys (clave secreta, no la pública)
STRIPE_SECRET_KEY=sk_live_...

# Dashboard de Stripe > Developers > Webhooks > tu endpoint > Signing secret
# El endpoint a registrar en Stripe es la URL de la función stripeWebhook,
# por ejemplo: https://stripewebhook-xxxxx.a.run.app
STRIPE_WEBHOOK_SECRET=whsec_...

# Sentry (error tracking) — panel Sentry > Settings > Client Keys (DSN)
SENTRY_DSN=https://xxxxx@o00000.ingest.sentry.io/00000
SENTRY_ENVIRONMENT=production
