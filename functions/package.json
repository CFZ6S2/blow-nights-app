{
  "name": "functions",
  "description": "Cloud Functions for Blow Nights",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "jest --forceExit --testPathIgnorePatterns=rules",
    "test:rules": "firebase emulators:exec --only firestore \"jest test/rules.test.js --forceExit\""
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "@sentry/node": "^10.70.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.3.2",
    "geofire-common": "^6.0.0",
    "stripe": "^22.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase-functions-test": "^3.0.0",
    "jest": "^30.4.2"
  },
  "private": true
}
